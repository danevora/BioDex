// BioDex Prisma Schema
// Full app with user authentication and capture persistence

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// NextAuth.js Models
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  password      String  // Hashed
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Profile fields
  username     String  @unique
  hasOnboarded Boolean @default(false)
  isSystemUser Boolean @default(false)

  // NextAuth relations
  accounts Account[]
  sessions Session[]

  // BioDex relations
  captures         Capture[]
  userAchievements UserAchievement[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// BioDex Models
model Animal {
  id             String   @id @default(cuid())
  commonName     String
  scientificName String
  class          String
  order          String
  family         String
  dietaryGroup   String
  habitat        String
  regions        String[]
  blurb          String   @db.Text
  hint           String   @default("")
  defaultImage   String?
  isActive          Boolean  @default(true)
  isUserSubmitted   Boolean  @default(false)
  isStarterAnimal   Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  captures Capture[]
}

model Capture {
  id         String   @id @default(cuid())
  userId     String
  animalId   String
  imageUrl   String
  imagePath  String // Storage path for deletion
  confidence Float?
  capturedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@unique([userId, animalId]) // One capture per animal per user
}

// Achievement Models (for future use)
model Achievement {
  id          String   @id @default(cuid())
  name        String   @unique
  description String   @db.Text
  category    String
  tier        String?
  iconUrl     String?
  criteria    Json
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  earnedAt      DateTime @default(now())
  progress      Json?

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}
